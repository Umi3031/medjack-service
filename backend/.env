# ------------------------------------------------------------------

# PostgreSQL-ийн нууц үг (Docker ашиглах үед)
DB_PASSWORD=ene-hesgiig-urt-nuuts-ugeer-solino

# Docker-гүй ажиллуулах үед өгөгдлийн сангийн хаяг.
# PostgreSQL:  postgresql+psycopg://medjack:NUUTS_UG@localhost:5432/medjack
# Туршилтад (сервергүй): sqlite:///./medjack.db
DATABASE_URL=sqlite:///./medjack.db

# JWT токены нууц түлхүүр. Дараах командаар үүсгэнэ:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ene-hesgiig-sanamsargui-urt-temdegteer-solino
JWT_EXPIRE_MINUTES=480

# Анх асаахад үүсэх админ (нэвтэрсний дараа нууц үгийг солино)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Medjack2026!

# QR код дээр бичигдэх хаяг. Сервер дээр домэйн нэрээ бичнэ:
#     PUBLIC_BASE_URL=https://service.medjack.mn
PUBLIC_BASE_URL=http://localhost:8000

COMPANY_NAME=МЕДЖЕК ХХК
SERVICE_PHONE=
